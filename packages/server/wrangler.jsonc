{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gate",
  "main": "src/platforms/cloudflare/entry.ts",
  "compatibility_date": "2026-09-01",
  // Validates config.yaml before every `wrangler dev` and `wrangler deploy`.
  "build": {
    "command": "node scripts/compile-config.ts",
  },
  "vars": {
    // GATE_* overrides, as upstream supports through Viper. Secrets are set with
    // `wrangler secret put`: GATE_APP_KEY_EXAMPLE_ORG, GATE_REVOCATION_KEYS.
    "GATE_LOGGER_LEVEL": "info",
  },
  "queues": {
    "producers": [{ "queue": "gate-revoke", "binding": "REVOKE" }],
    "consumers": [
      {
        "queue": "gate-revoke",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "gate-revoke-dlq",
      },
    ],
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
}
