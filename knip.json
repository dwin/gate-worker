{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/core": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/testkit": {
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/platforms/*/entry.ts", "scripts/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/action": {
      "entry": ["src/main.ts", "src/post.ts", "scripts/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    }
  }
}
